{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cottman99/ansysem-agent-bridge/schemas/ansysem-hfss3dlayout-solve-v1.schema.json",
  "title": "AnsysEM HFSS 3D Layout Solve Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "source_project",
    "output_project",
    "version",
    "design",
    "setup",
    "sweep",
    "expressions",
    "report_name"
  ],
  "properties": {
    "schema_version": {"const": "ansysem.hfss3dlayout-solve/v1"},
    "operation_id": {"$ref": "#/$defs/identifier"},
    "source_project": {"type": "string", "minLength": 1},
    "output_project": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "design": {"$ref": "#/$defs/identifier"},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "setup": {"$ref": "#/$defs/identifier"},
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "start", "stop", "step"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "start": {"$ref": "#/$defs/frequency"},
        "stop": {"$ref": "#/$defs/frequency"},
        "step": {"$ref": "#/$defs/frequency"}
      }
    },
    "expressions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n\\u0000]+$"}
    },
    "report_name": {"$ref": "#/$defs/identifier"},
    "minimum_points": {"type": "integer", "minimum": 1},
    "cores": {"type": "integer", "minimum": 1, "maximum": 64}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_ .-]{0,127}$"
    },
    "frequency": {
      "type": "string",
      "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:Hz|kHz|MHz|GHz|THz)$"
    }
  }
}
