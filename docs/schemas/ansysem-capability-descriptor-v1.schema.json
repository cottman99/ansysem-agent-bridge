{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cottman99/ansysem-agent-bridge/schemas/ansysem-capability-descriptor-v1.schema.json",
  "title": "AnsysEM Capability Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "category", "safety", "lanes", "mutates", "latency_class", "requirements", "state", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "safety": {"enum": ["safe", "bounded", "unsafe"]},
    "lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["host", "docs", "pyaedt-live", "pyedb-offline", "native-aedt", "solver-batch", "gui-assist"]}
    },
    "mutates": {"type": "boolean"},
    "latency_class": {"enum": ["fast", "moderate", "slow", "variable"]},
    "requirements": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "compatible", "available", "healthy", "authorized", "reason", "safe_next_actions"],
      "properties": {
        "declared": {"type": "boolean"},
        "compatible": {"type": "boolean"},
        "available": {"type": "boolean"},
        "healthy": {"type": "boolean"},
        "authorized": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "safe_next_actions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
