{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cottman99/ansysem-agent-bridge/schemas/ansysem-operation-plan-v1.schema.json",
  "title": "AnsysEM Typed Operation Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "adapter", "source_project", "output_project", "version", "design", "operations", "assertions"],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["hfss3dlayout.native/v1", "hfss3dlayout.pyedb-native/v1"]},
    "profile": {"type": "string", "minLength": 1},
    "source_project": {"type": "string", "pattern": "\\.[aA][eE][dD][tT]$"},
    "output_project": {"type": "string", "pattern": "\\.[aA][eE][dD][tT]$"},
    "version": {"type": "string", "minLength": 1},
    "design": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"port": {"type": "integer", "minimum": 0}}
    },
    "solve_requested": {"const": false},
    "redact_paths": {"type": "boolean"},
    "source_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aedt_sha256", "edb_definition_sha256"],
      "properties": {
        "aedt_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "edb_definition_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "$defs": {
    "setProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "server", "property", "value"],
      "properties": {
        "type": {"const": "set_property"},
        "tab": {"const": "BaseElementTab"},
        "server": {"type": "string", "minLength": 1},
        "property": {"type": "string", "minLength": 1},
        "value": {},
        "expected_before": {}
      }
    },
    "createGapPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "positive_object", "selected_side", "port_name", "reference_patch"],
      "properties": {
        "type": {"const": "create_gap_port"},
        "positive_object": {"type": "string", "minLength": 1},
        "selected_side": {"enum": ["L", "R", "T", "B"]},
        "port_name": {"type": "string", "minLength": 1},
        "reference_patch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "net", "depth_um"],
          "properties": {
            "layer": {"type": "string", "minLength": 1},
            "net": {"type": "string", "minLength": 1},
            "depth_um": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "HFSS Type": {"const": "Gap"},
            "Renormalize": {"type": "boolean"},
            "Renormalize Impedance": {"type": "string"},
            "DeembedParasiticPortInductance": {"type": "boolean"}
          }
        }
      }
    },
    "apdSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizontal_mode", "horizontal_value", "vertical_mode", "vertical_value"],
      "properties": {
        "horizontal_mode": {"enum": ["absolute_um", "fraction", "angle_deg", "switch"]},
        "horizontal_value": {"type": "number"},
        "vertical_mode": {"enum": ["absolute_um", "fraction", "angle_deg", "switch"]},
        "vertical_value": {"type": "number"}
      }
    },
    "bondwireState": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "start_xy_um": {"$ref": "#/$defs/xy"},
        "end_xy_um": {"$ref": "#/$defs/xy"},
        "bondwire_type": {"enum": ["apd", "jedec4", "jedec5"]},
        "profile": {"type": "string", "minLength": 1},
        "diameter_um": {"type": "number", "exclusiveMinimum": 0},
        "material": {"type": "string", "minLength": 1}
      }
    },
    "xy": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
    "ensureApdProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "name", "direction", "diameter_um", "material", "segments"],
      "properties": {
        "type": {"const": "ensure_apd_bondwire_profile"},
        "name": {"type": "string", "minLength": 1},
        "direction": {"enum": ["forward", "reverse"]},
        "diameter_um": {"type": "number", "exclusiveMinimum": 0},
        "material": {"type": "string", "minLength": 1},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/apdSegment"}}
      }
    },
    "setBondwire": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "name", "expected_before"],
      "properties": {
        "type": {"const": "set_bondwire"},
        "name": {"type": "string", "minLength": 1},
        "expected_before": {"$ref": "#/$defs/bondwireState"},
        "start_xy_um": {"$ref": "#/$defs/xy"},
        "end_xy_um": {"$ref": "#/$defs/xy"},
        "bondwire_type": {"enum": ["apd", "jedec4", "jedec5"]},
        "profile": {"type": "string", "minLength": 1},
        "diameter_um": {"type": "number", "exclusiveMinimum": 0},
        "material": {"type": "string", "minLength": 1}
      }
    },
    "operation": {"oneOf": [{"$ref": "#/$defs/setProperty"}, {"$ref": "#/$defs/createGapPort"}, {"$ref": "#/$defs/ensureApdProfile"}, {"$ref": "#/$defs/setBondwire"}]},
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "id": {"type": "string"},
        "type": {
          "enum": ["property_equals", "same_property", "object_exists", "port_count", "required_ports", "setup_count", "required_setups", "port_property_equals", "port_property_contains", "design_equals", "display_equals", "bondwire_matches", "bondwire_projected_length", "bondwire_profile_height", "bondwire_endpoint_in_conductor", "bondwire_obstacle_clearance", "bondwire_pairwise_clearance", "bondwire_count", "geometry_check_clean"]
        },
        "tab": {"const": "BaseElementTab"},
        "server": {"type": "string"},
        "left_server": {"type": "string"},
        "right_server": {"type": "string"},
        "property": {"type": "string"},
        "name": {"type": "string"},
        "port": {"type": "string"},
        "value": {},
        "expected": {"type": "object"},
        "value_um": {"type": "number"},
        "tolerance_um": {"type": "number", "minimum": 0},
        "endpoint": {"enum": ["start", "end"]},
        "conductor": {"type": "string"},
        "obstacles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "minimum_um": {"type": "number"},
        "names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "start_contact_exemption_um": {"type": "number", "minimum": 0}
      }
    }
  }
}
